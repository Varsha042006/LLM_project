# =============================================================================
# LocalGPT Pro — Streamlit Configuration & Firebase Secrets
# =============================================================================
# Instructions:
# 1. Fill in the values below from your Firebase Console:
#    Project Overview > Project settings > General > Your apps > LocalGPT-Web
# 2. Never commit this file to version control (protected by .gitignore).
# =============================================================================

[firebase]
apiKey = "AIzaSyYOUR_FIREBASE_WEB_API_KEY_HERE"
authDomain = "localgpt-pro.firebaseapp.com"
projectId = "localgpt-pro"
storageBucket = "localgpt-pro.appspot.com"
messagingSenderId = "123456789012"
appId = "1:123456789012:web:abcdef1234567890"

# Optional: Firebase Admin Service Account path for server-side token revocation checks
# Download from Firebase Console > Project settings > Service accounts > Generate new private key
# service_account_path = "firebase-service-account.json"

